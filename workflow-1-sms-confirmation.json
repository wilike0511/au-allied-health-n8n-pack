    {
      "parameters": {
        "jsCode": "const currentEvent = $('Set: Extract Inputs').item.json;\nconst SIXTY_MIN_MS = 60 * 60 * 1000;\nconst now = Date.now();\n\nconst recentSend = items.find(it => {\n  if (it.json.status !== 'sent') return false;\n  const sentAt = new Date(it.json.timestamp_iso).getTime();\n  return (now - sentAt) < SIXTY_MIN_MS;\n});\n\nif (recentSend) {\n  return [{ json: { ...currentEvent, idempotent_skip: true } }];\n}\nreturn [{ json: { ...currentEvent, idempotent_skip: false } }];"
      },
