      "parameters": {
        "jsCode": "const STATUS = {\n  VALID: 'valid',\n  EMPTY: 'empty',\n  INVALID_FORMAT: 'invalid_format',\n  LIKELY_LANDLINE: 'likely_landline',\n};\n\nreturn items.map(item => {\n  const raw = (item.json.phone_raw || '').trim();\n\n  if (!raw) {\n    return { json: { ...item.json, phone_e164: '', phone_status: STATUS.EMPTY } };\n  }\n\n  let digits = raw.replace(/[^\\d+]/g, '');\n  if (digits.startsWith('+')) {\n    digits = '+' + digits.slice(1).replace(/\\+/g, '');\n  } else {\n    digits = digits.replace(/\\+/g, '');\n  }\n\n  let e164 = '';\n\n  if (/^04\\d{8}$/.test(digits)) {\n    e164 = '+61' + digits.slice(1);\n  } else if (/^\\+614\\d{8}$/.test(digits)) {\n    e164 = digits;\n  } else if (/^614\\d{8}$/.test(digits)) {\n    e164 = '+' + digits;\n  } else if (/^4\\d{8}$/.test(digits)) {\n    e164 = '+61' + digits;\n  } else if (/^0[2378]\\d{8}$/.test(digits)) {\n    return { json: { ...item.json, phone_e164: '', phone_status: STATUS.LIKELY_LANDLINE } };\n  } else {\n    return { json: { ...item.json, phone_e164: '', phone_status: STATUS.INVALID_FORMAT } };\n  }\n\n  return { json: { ...item.json, phone_e164: e164, phone_status: STATUS.VALID } };\n});"
      },
