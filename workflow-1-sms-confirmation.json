              "id": "smsb0001-0000-0000-0000-000000000001",
              "name": "sms_body",
              "value": "={{ (() => { const start = new Date($('Set: Extract Inputs').item.json.event_start_iso); const tz = $('Set: Extract Inputs').item.json.event_timezone || 'Australia/Perth'; const dateStr = start.toLocaleDateString('en-AU', { weekday: 'short', day: '2-digit', month: 'short', timeZone: tz }); const timeStr = start.toLocaleTimeString('en-AU', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: tz }); const loc = $('Set: Extract Inputs').item.json.event_location; const clinic = $('Clinic Config').first().json.clinic_name; const url = $('Clinic Config').first().json.reschedule_url; return `Hi, this is ${clinic}. Your appointment is confirmed for ${dateStr} at ${timeStr}` + (loc ? ` (${loc})` : '') + `. To reschedule or cancel, visit ${url}. Reply STOP to opt out.`; })() }}",
